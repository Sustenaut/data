{
  "kind": "service",
  "bin": "data",
  "ci": {
    "events": [
      "pr",
      "main"
    ],
    "with": {
      "setup": "make venv",
      "test": "make functional",
      "shellcheck": "bin/data",
      "terraform-dir": "infra"
    }
  },
  "hosting": {
    "providers": {
      "gcp": {
        "type": "google-cloud",
        "project": "sustenaut",
        "region": "europe-north1",
        "cloud_run": {
          "domain_target": "ghs.googlehosted.com."
        }
      }
    }
  },
  "protect": {
    "checks": [
      "ci / passed"
    ],
    "tags": false
  }
}
